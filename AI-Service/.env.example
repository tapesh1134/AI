# Copy to .env. Keep .env private. Run commands from AI-Service.
# Include /v1 in the base URL only if your company gateway requires it.
LLM_BASE_URL=https://your-company-gateway.example/v1
LLM_CHAT_PATH=/chat/completions
LLM_API_KEY=replace-with-your-chat-key
LLM_MODEL=replace-with-your-chat-model
LLM_AUTH_HEADER=Authorization
LLM_AUTH_PREFIX="Bearer "
# Optional provider-specific settings, e.g. {"max_completion_tokens":2000}.
# Temperature is deliberately omitted for models that do not support it.
LLM_EXTRA_BODY={}

# Embeddings may use a separate endpoint, key and model.
EMBEDDING_BASE_URL=https://your-company-gateway.example/v1
EMBEDDING_PATH=/embeddings
EMBEDDING_API_KEY=replace-with-your-embedding-key
EMBEDDING_MODEL=replace-with-your-embedding-model
EMBEDDING_AUTH_HEADER=Authorization
EMBEDDING_AUTH_PREFIX="Bearer "
EMBEDDING_FORMAT=openai
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_EXTRA_BODY={}
PROVIDER_TIMEOUT=45
MAX_TOOL_ROUNDS=5

# Python validates the SAME raw UTF-8 key as spring.application.key in Auth-Service.
# Use the signing algorithm selected by JJWT for that key: HS256 for 32-47 bytes,
# HS384 for 48-63 bytes, HS512 for 64+ bytes. Current uploaded key uses HS256.
JWT_SECRET=replace-with-your-existing-Spring-signing-key
JWT_ALGORITHM=HS256
JWT_COOKIE_NAME=jwt
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:8080

# Existing Spring databases. Match your local credentials. URL-encode special
# characters in usernames/passwords. Use read-only accounts for deployment.
AUTH_DATABASE_URL=postgresql+psycopg://postgres:replace-password@localhost:5432/job-portal-auth
JOB_DATABASE_URL=postgresql+psycopg://postgres:replace-password@localhost:5432/job-portal-jobpost
APPLICATION_DATABASE_URL=postgresql+psycopg://postgres:replace-password@localhost:5432/job-portal-application
PROFILE_DATABASE_URL=postgresql+psycopg://postgres:replace-password@localhost:5432/job-portal-profile
PROFILE_SKILLS_FK=candidate_profile_profile_id

# Separate pgvector DB. Existing PostgreSQL on 5432 remains usable.
AI_DATABASE_URL=postgresql+psycopg://ai:ai_local_password@localhost:5433/jobportal_ai
REQUESTS_PER_MINUTE=20
